# Mandate — test-mode only. Never commit a filled .env.
# Copy to .env and fill. Keys must start with rzp_test_. Live keys (rzp_live_) are forbidden.

# Dashboard → Account & Settings → API Keys (Test mode)
# https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_
RAZORPAY_KEY_SECRET=

# RazorpayX customer identifier / current-account number (payouts). Leave blank until Day-0 rail check.
RAZORPAY_ACCOUNT_NUMBER=

# Remote MCP (streamable HTTP). Merchant token is Base64(KEY_ID:KEY_SECRET) — derived at runtime, do not commit.
RAZORPAY_MCP_URL=https://mcp.razorpay.com/mcp

# Operator Ed25519 keys are generated locally by the dashboard. Proxy stores the public key only.
# OPERATOR_PUBLIC_KEY=

# SQLite (Prisma). Relative to packages/db/prisma/schema.prisma.
DATABASE_URL="file:../dev.db"

# Resource-server webhook HMAC secret (per provider). Generated in T-002+.
# WEBHOOK_SECRET_COMPUTE=
# WEBHOOK_SECRET_LLM=
